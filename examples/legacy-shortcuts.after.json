{
  "dsl": "FrameForge",
  "version": "2.2.0",
  "title": "Every deprecated form, in one document",
  "description": "The BEFORE half of the migration pair. Deliberately NOT valid at HEAD: it carries the two removed forms (a pre-P3 inline stroke bundle and the pre-P4 content-sizing `size`) alongside every still-accepted legacy spelling. `ff-codemod --write` turns this file into legacy-shortcuts.after.json, and tests/test_deprecations.py asserts the pair has not drifted.",
  "defs": {
    "tokens": {
      "colors": {
        "ink": "#1d1d1b",
        "rule": "#d5d0c6"
      },
      "styles": {
        "body": {
          "font_size": "10pt",
          "line_height": "13pt"
        },
        "lead": {
          "font_size": "14pt"
        },
        "caption": {
          "font_size": "8pt"
        }
      }
    }
  },
  "pages": [
    {
      "mode": "page",
      "id": "p1",
      "canvas": {
        "size": [
          420,
          300
        ],
        "units": "px"
      },
      "layers": [
        {
          "id": "main",
          "objects": [
            {
              "type": "ellipse",
              "id": "dot",
              "center": [
                60,
                60
              ],
              "fill": "#d4145a",
              "rx": 24,
              "ry": 24
            },
            {
              "type": "polyline",
              "id": "wedge",
              "points": [
                [
                  140,
                  40
                ],
                [
                  200,
                  40
                ],
                [
                  170,
                  92
                ]
              ],
              "fill": "#eeeae1",
              "closed": true
            },
            {
              "type": "path",
              "id": "swash",
              "stroke": "#1d1d1b",
              "d": [
                [
                  "M",
                  240,
                  40
                ],
                [
                  "C",
                  280,
                  10,
                  360,
                  120,
                  400,
                  90
                ]
              ]
            },
            {
              "type": "rect",
              "id": "panel",
              "box": [
                20,
                130,
                180,
                90
              ],
              "fill": {
                "kind": "linear",
                "angle": 90,
                "stops": [
                  {
                    "color": "#ffffff",
                    "position": "0%"
                  },
                  {
                    "color": "#eeeae1",
                    "position": "50%"
                  },
                  {
                    "color": "#d5d0c6",
                    "position": "100%"
                  }
                ]
              },
              "sizing": {
                "width": "fill",
                "height": "hug",
                "grow": 1
              }
            },
            {
              "type": "line",
              "id": "rule",
              "from": [
                20,
                240
              ],
              "to": [
                400,
                240
              ],
              "stroke": "#d5d0c6",
              "stroke_style": {
                "stroke_width": 1,
                "stroke_dasharray": "4 2",
                "stroke_linecap": "round"
              }
            },
            {
              "type": "text",
              "id": "caption",
              "box": [
                220,
                130,
                180,
                40
              ],
              "text": "Deprecated, not removed.",
              "stroke_style": {
                "stroke_width": 0.5,
                "stroke_dasharray": "2 2"
              }
            },
            {
              "type": "connector",
              "id": "link",
              "from": {
                "side": "east",
                "ref": "panel"
              },
              "to": {
                "side": "west",
                "ref": "caption"
              },
              "route": {
                "kind": "orthogonal"
              },
              "stroke": "#1d1d1b"
            }
          ]
        }
      ]
    }
  ]
}
